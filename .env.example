# Configurar no servidor. Nunca colocar a chave no HTML ou no repositório.
GROQ_API_KEY=
OLHAN_AI_ACCESS_CODE=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3

# Cloudflare R2: somente no servidor, endpoint sem /nome-do-bucket.
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Compatibilidade com os segredos já cadastrados: R2_ACESS_KEY_ID e R2_SECRET_ACESS_KEY.
